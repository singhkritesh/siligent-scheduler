# Copy to .env and replace every CHANGE_ME value before starting.
COMPOSE_PROJECT_NAME=siligent-scheduler

# Bind to 127.0.0.1 for a single-machine evaluation. A production installation
# should use the approved practice-network interface and internal TLS gateway.
BIND_ADDRESS=127.0.0.1
UI_PORT=8443

POSTGRES_DB=siligent_scheduler
POSTGRES_USER=siligent_scheduler
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

PRACTICE_NAME="Siligent Dental"
PRACTICE_TIMEZONE=America/New_York
SCHEDULING_HORIZON_DAYS=365
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_SECRET
SESSION_HOURS=8

# Images are built/retrieved during a connected installation or imported from a
# signed offline bundle. Runtime pulling and building are disabled by start.sh.
DATABASE_IMAGE=postgres@sha256:20edbde7749f822887a1a022ad526fde0a47d6b2be9a8364433605cf65099416
API_IMAGE=siligent-scheduler-api:local

# Scheduling works without a language model. Set this to true only when the
# separately approved local-AI pack (Ollama plus the pinned model) is installed.
# The installer also supports --without-llm and --with-local-model.
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_URL=http://host.docker.internal:11434/api/generate
LOCAL_MODEL_ID=qwen3.5:4b

# Scheduling works immediately from clinician-approved defaults. Local completed
# visit data is optional and only stages refinements after this evidence floor.
CALIBRATION_MIN_SAMPLES=20
